# Application Settings
APP_NAME=FastAPI Demo
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
APP_PORT=8000

# MySQL Database Settings
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=fastapi_demo
MYSQL_USER=fastapi_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Optional explicit DATABASE_URL.
# If left empty, DATABASE_URL is constructed automatically from the MYSQL_* variables above:
# mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?charset=utf8mb4
DATABASE_URL=
